<Window x:Class="Lab3_Shop_Baimurzin.ProductListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список товаров" Height="600" Width="900" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen" Language="ru-RU" FontFamily="Times New Roman" FontSize="14">

    <Window.Resources>
        <!-- Карточка товара по шаблону: слева данные, справа действующая скидка -->
        <DataTemplate x:Key="ProductCardTemplate">
            <Border x:Name="Card" BorderBrush="Black" BorderThickness="2" Margin="20,8"
                    Padding="10" Background="White" Cursor="Hand"
                    ToolTip="Нажмите, чтобы редактировать товар"
                    MouseLeftButtonUp="Card_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="Black" BorderThickness="1" Padding="6" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" FontSize="16">
                                <Run Text="{Binding CategoryName, Mode=OneWay}"/>
                                <Run Text=" | "/>
                                <Run Text="{Binding Article, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock>
                                <Run Text="Наименование товара: "/>
                                <Run Text="{Binding ProductTitle, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Description}">
                                <Run Text="Описание товара: "/>
                                <Run Text="{Binding Description, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock>
                                <Run Text="Производитель: "/>
                                <Run Text="{Binding ManufacturerName, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock>
                                <Run Text="Поставщик: "/>
                                <Run Text="{Binding SupplierName, Mode=OneWay}"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Цена: "/>
                                <TextBlock x:Name="OldPrice" Margin="0,0,6,0"
                                           Text="{Binding Price, StringFormat={}{0:0.##} ₽}"/>
                                <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:0.##} ₽}"/>
                            </StackPanel>
                            <TextBlock>
                                <Run Text="Количество на складе: "/>
                                <Run Text="{Binding Count, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Действующая скидка" FontSize="12"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding DiscountValue, StringFormat={}{0}%}"
                                       FontSize="26" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <!-- Подсветка товаров со скидкой больше 20% -->
                <DataTrigger Binding="{Binding IsBigDiscount}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="#C8A2C8"/>
                </DataTrigger>
                <!-- Без скидки старая цена не показывается -->
                <DataTrigger Binding="{Binding HasDiscount}" Value="False">
                    <Setter TargetName="OldPrice" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                    <Setter TargetName="OldPrice" Property="TextDecorations" Value="Strikethrough"/>
                    <Setter TargetName="OldPrice" Property="Foreground" Value="Red"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Expander Header="Средства поиска" IsExpanded="True" Margin="6" BorderBrush="Gray">
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" Padding="2"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="Ищет по артикулу, наименованию, категории, описанию, производителю и поставщику. Несколько слов через пробел — все должны найтись."/>
                <Button x:Name="AddButton" Grid.Column="2" Content="Добавить товар" Margin="10,0,0,0"
                        Padding="12,2" Click="AddButton_Click"/>
            </Grid>
        </Expander>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Products}"
                          ItemTemplate="{StaticResource ProductCardTemplate}"/>
        </ScrollViewer>

        <TextBlock x:Name="CounterText" Grid.Row="2" Margin="10,4" Foreground="Gray"/>
    </Grid>
</Window>
